# The collection against the bank's systems. Every variable a deployable reads, with a placeholder that looks
# like one. Secrets are NAMES in the secrets provider (HUB_SECRETS / AGENT_SECRETS), never values. Copy the block
# a service needs into its task definition or env file; `check-config` names every gap before a process listens.

# ============ hub-api (services/hub-api): the hub's API and the hub itself ============
HUB_ENV=production                              # sandbox | staging | production (mock identity and the fake assistant are refused in production)
HUB_AUTH=oidc                                   # oidc | mock
HUB_LISTEN_HOST=0.0.0.0
HUB_LISTEN_PORT=8080
HUB_PUBLIC_URL=https://hub.bank.example         # https in staging and production
HUB_DB=/var/hub/hub.db                          # the record: briefs, requests, sign-offs; a file on a persistent volume
HUB_STATIC_DIR=/app/hub-dist                    # the hub's built dist/; empty serves the API only
HUB_KB_URL=https://kb.bank.example              # the knowledge base's console, linked from Learn
# identity: the bank's provider
HUB_IDP_ISSUER=https://idp.bank.example/TENANT_ID/v2.0
HUB_IDP_AUDIENCE=HUB_WEB_CLIENT_ID              # the client id the hub's tokens carry in aud
HUB_IDP_JWKS_URL=                               # optional; derived from the issuer's discovery document when empty
HUB_IDENTITY_MAP=/app/config/identity-map.json  # directory group ids -> roles, entitlements, teams, ladder (platform team)
HUB_AI_SECURITY_GROUP=GROUP_ID_AI_SECURITY      # members sign components off for AI security
HUB_OWNER_DOMAIN=bank.example                   # the directory's email domain; an owner signs only from it (required with oidc)
# the hub's own runtime configuration, served to the browser as /config.js (public values; one built hub runs everywhere)
HUB_WEB_OIDC_AUTHORITY=https://idp.bank.example/TENANT_ID/v2.0
HUB_WEB_OIDC_CLIENT_ID=HUB_WEB_CLIENT_ID
HUB_WEB_OIDC_REDIRECT_URI=                      # <HUB_PUBLIC_URL>/auth/callback when empty
HUB_WEB_OIDC_POST_LOGOUT_URI=                   # <HUB_PUBLIC_URL>/ when empty
HUB_WEB_OIDC_SCOPE="openid profile email"     # quoted: the file is sourced by a shell. Add the API's scope where the provider binds aud to it (api://HUB_WEB_CLIENT_ID/.default on Entra) and offline_access to renew by refresh token instead of a hidden frame
HUB_MAX_BODY_BYTES=1000000                      # largest request body accepted (10000 to 50000000)
# the bank's own listings and registry (the hub's shape; see services/hub-api/data/consumers.example.json)
HUB_CONSUMERS_FILE=/app/config/consumers.json
HUB_COLLECTION_FILE=/app/data/collection.json   # generated by tools/shelf.py --write; shipped in the image
HUB_GUIDE_FILE=/app/data/guide-corpus.json      # the guide's passages, generated by the same command; shipped in the image
# the employee assistant: http (the platform runtime owns it) | bedrock (answered here) | fake (never in production)
HUB_ASSISTANT=http
HUB_ASSISTANT_URL=https://runtime.bank.example
HUB_ASSISTANT_TOKEN_NAME=hub/assistant-token    # a name in the secrets provider
HUB_KB_SEARCH_URL=https://kb.bank.example/api/search   # bedrock: sources for citations (optional)
HUB_BEDROCK_REGION=us-east-1
HUB_BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com   # the bank's VPC endpoint in production
HUB_BEDROCK_MODEL_ID=MODEL_ID_APPROVED_BY_MODEL_RISK
HUB_BEDROCK_INFERENCE_PROFILE_ARN=arn:aws:bedrock:us-east-1:000000000000:application-inference-profile/hub-assistant
HUB_BEDROCK_MAX_OUTPUT_TOKENS=1500              # bedrock: the answer's ceiling (100 to 100000)
# secrets and logs
HUB_SECRETS=aws                                 # aws | file:/path.json | env (env is refused in staging and production)
AWS_REGION=us-east-1
HUB_RATE_PER_MINUTE=300                         # requests per person per minute; must be above 0 outside the sandbox
HUB_IDEMPOTENCY_TTL_S=86400                     # how long a replayed answer is kept
HUB_CONVERSATION_RETENTION_DAYS=90              # conversations older than this are deleted daily; must be set outside the sandbox
HUB_LOG_LEVEL=INFO
HUB_BUILD_SHA=GIT_SHA                           # shown on /api/health and in /config.js; set by the pipeline

# ============ agent-runtime (services/agent-runtime): an agent of the collection served over MCP ============
AGENT_ENV=production                            # sandbox | staging | production (fakes are refused in production)
AGENT_NAME=incident-first-read-agent            # the agent component to serve; its TEMPLATE.md is the catalog
AGENT_LISTEN_HOST=0.0.0.0
AGENT_LISTEN_PORT=8081
AGENT_PUBLIC_URL=https://agents.bank.example/incident-first-read/mcp   # the RFC 9728 resource
AGENT_DB=/var/agent/record.db                   # sessions, the chain, kill switches, telemetry
AGENT_IDENTITY=oidc                             # oidc | fake (fake is refused in staging and production)
AGENT_IDP_ISSUER=https://idp.bank.example/TENANT_ID/v2.0
AGENT_IDP_AUDIENCE=AGENT_CLIENT_ID
AGENT_IDP_JWKS_URL=                             # optional; derived from the issuer's discovery document when empty
AGENT_OPERATOR_GROUP_ID=GROUP_ID_OPERATORS      # directory group -> operator: who may act through the agent
AGENT_APPROVER_GROUP_ID=GROUP_ID_APPROVERS      # directory group -> approver: who may confirm a write on another person's behalf
AGENT_SIGNING=kms                               # kms | local (local is refused in staging and production)
AGENT_KMS_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/KEY_ID   # signs the catalog and rule bundle
AGENT_ENGINE=bedrock                            # bedrock | rules (rules is refused in staging and production)
AGENT_BEDROCK_REGION=us-east-1                  # AWS_REGION when empty
AGENT_BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com   # the bank's VPC endpoint; required in staging and production
AGENT_BEDROCK_MODEL_ID=MODEL_ID_APPROVED_BY_MODEL_RISK
AGENT_BEDROCK_INFERENCE_PROFILE_ARN=arn:aws:bedrock:us-east-1:000000000000:application-inference-profile/incident-first-read
AGENT_BEDROCK_MAX_OUTPUT_TOKENS=1500            # the think step's ceiling per call
# targets: the template names tickets and deploys; each is real when listed here and a fake otherwise (fakes are refused in staging and production)
AGENT_TARGETS=tickets,deploys
AGENT_JIRA_URL=https://jira.bank.example
AGENT_JIRA_USER=SERVICE_ACCOUNT_EMAIL@bank.example   # basic: the service account the token belongs to (Jira Cloud); unused with bearer
AGENT_JIRA_AUTH=basic                           # basic (user + API token, Jira Cloud) | bearer (a personal access token, Data Center)
AGENT_JIRA_TOKEN_NAME=agents/jira-token         # a name in the secrets provider
AGENT_DEPLOYS_URL=https://dev.azure.com/ORG      # Azure DevOps, the deploy system of record
AGENT_DEPLOYS_PROJECT=PROJECT
AGENT_DEPLOYS_PIPELINES=checkout=PIPELINE_ID    # service=pipeline id (a number), comma separated: which pipeline answers for which service; check-config refuses this placeholder until it is real
AGENT_DEPLOYS_PAT_NAME=agents/ado-pat           # a name in the secrets provider
AGENT_AUDIT_EXPORT=s3://BUCKET/agents/incident-first-read/   # the chain's export destination; required in production
AGENT_AUDIT_EXPORT_INTERVAL_S=3600              # export from inside the task every hour; 0 leaves it to a scheduled `export-audit`
AGENT_RUNS_PER_MINUTE=60                        # runs and confirmations per person per minute; must be above 0 outside the sandbox
AGENT_MAX_BODY_BYTES=1000000                    # largest request body accepted (10000 to 50000000)
AGENT_SECRETS=aws                               # aws | file:/path.json | env (env is refused in staging and production)
AGENT_LOG_LEVEL=INFO
AGENT_BUILD_SHA=GIT_SHA                         # shown on /health and as the MCP server's version; set by the pipeline

# ============ shelf-mcp-server (components/python/shelf-mcp-server): read-only, for coding assistants ============
SHELF_ROOT=/app                                 # a checkout of the collection (the components/ tree)

# ============ the hub's build ============
# Nothing: the hub is built once (the release bundle ships hub/dist) and reads /config.js from hub-api at runtime.
# hub/.env.production.example remains for a hub served by a static host without hub-api.
