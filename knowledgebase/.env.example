# Reference only. kb-librarian reads the process environment and never a .env file,
# so inject these from your organisation's secret manager at runtime.

# One of the two credentials below is required for LLM-backed audits.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Librarian behaviour (all optional; defaults live in kb_librarian/config.py). KB_ROOT points every
# command and the server at the project when it is not run from inside it (the container sets it).
# An empty value reads as unset; a rejected value is reported as `FAIL settings — KB_<VAR>: …`.
KB_MODEL=claude-opus-5
KB_MAX_TURNS=40
KB_MAX_BUDGET_USD=2.0
KB_ALLOW_LIVE=false
# The librarian chat is one short turn per question with its own, smaller ceilings.
KB_CHAT_MAX_TURNS=6
KB_CHAT_MAX_BUDGET_USD=0.5
# Operational readiness: the chat's daily ceiling summed over every client (.librarian/chat-spend.json;
# POST /api/chat is 429 once reached), and the root logger's level (DEBUG|INFO|WARNING|ERROR) and format.
KB_CHAT_DAILY_BUDGET_USD=25.0
KB_LOG_LEVEL=INFO
KB_LOG_FORMAT=json

# Retrieval (semantic search and the librarian's `semantic_search` tool). `kb-librarian index --embeddings`
# builds .librarian/index/embeddings.sqlite from every page. With KB_EMBED_URL unset the offline hash
# embedder is used: deterministic token overlap only — no synonyms, no meaning, nothing leaves the host.
# A real provider is the bank's choice: any OpenAI-compatible or Voyage-style https endpoint (an
# on-premises one keeps page text inside); KB_EMBED_MODEL is then required, the key is optional and never
# logged. KB_EMBED_DIM sizes the hash embedder only. Changing the endpoint or the model needs a rebuild
# (doctor warns until then). Search-box embedder calls are capped at 30 per client per minute.
KB_EMBED_URL=
KB_EMBED_MODEL=
KB_EMBED_API_KEY=
KB_EMBED_DIM=256

# Operator (admin) bearer key for the API and console: whoever presents it may start, cancel and
# roll back audits. Leave empty and nobody is an operator.
KB_API_KEY=

# Single sign-on (OpenID Connect against your identity provider). Sign-in exists only when
# issuer, client id, redirect URI and session secret are all set. Issuer and redirect URI must be
# https (http only for localhost); the session secret must be at least 32 characters (rotating it
# signs everyone out). The client secret is optional (a public client relies on PKCE).
KB_OIDC_ISSUER=https://login.your-idp.example/realms/your-realm
KB_OIDC_CLIENT_ID=
KB_OIDC_CLIENT_SECRET=
KB_OIDC_REDIRECT_URI=https://kb.your-domain.example/api/auth/callback
KB_OIDC_SCOPES=openid profile email
KB_SESSION_SECRET=
KB_SESSION_TTL_HOURS=12

# Operator role from identity. The identity provider must put the group claim in the ID token
# (not only in the access token or userinfo): KB_OIDC_GROUPS_CLAIM names that claim (only a list
# of strings counts) and KB_OIDC_OPERATOR_GROUPS lists, comma-separated, the groups that grant the
# operator role; empty = a sign-in never grants it (KB_API_KEY alone does). The role is decided
# once at sign-in and stored in the session: a group change takes effect at the next sign-in.
KB_OIDC_GROUPS_CLAIM=groups
KB_OIDC_OPERATOR_GROUPS=

# Atlassian Cloud (Confluence + Jira). Reads work with these three values;
# writes additionally require KB_ATLASSIAN_ALLOW_WRITE=true and a live run.
KB_ATLASSIAN_BASE_URL=https://your-tenant.atlassian.net
KB_ATLASSIAN_EMAIL=
KB_ATLASSIAN_API_TOKEN=
KB_ATLASSIAN_ALLOW_WRITE=false

# Reader-record retention: records untouched for this many days are removed by the deployment's
# scheduled `kb-librarian profiles purge --live` (CronJob / host cron). Empty = no automatic purge.
KB_PROFILE_RETENTION_DAYS=

# Insights: retention of the chat telemetry lines (.librarian/chat-log.jsonl; `kb-librarian insights
# prune` drops older ones) and the k-anonymity threshold: a page with fewer distinct readers than this
# shows no reader-derived count in `kb-librarian insights` / GET /api/insights.
KB_CHAT_LOG_DAYS=90
KB_INSIGHTS_K=5
