# CrossRiver AI Hub — runtime configuration (validated at boot by src/config/env.ts)

# API
VITE_API_BASE=/api            # base URL of the Hub API; relative when served behind the same origin
VITE_API_MODE=mock            # http | mock (in-browser fixtures for dev, demos and tests)

# Authentication
VITE_AUTH_MODE=mock           # oidc | mock
# Required when VITE_AUTH_MODE=oidc (Authorization Code + PKCE against the bank's IdP):
# VITE_OIDC_AUTHORITY=https://login.crossriver.example/realms/staff
# VITE_OIDC_CLIENT_ID=crai-hub
# VITE_OIDC_REDIRECT_URI=https://hub.crai.example/auth/callback
# VITE_OIDC_POST_LOGOUT_URI=https://hub.crai.example/signin
# VITE_OIDC_SCOPE=openid profile email

# Hosting
VITE_ROUTER=browser           # browser (host rewrites every path to index.html) | hash (static host)
VITE_TELEMETRY=none           # none | console
VITE_BUILD_SHA=dev            # stamped by CI; shown in Settings and sent as X-Client-Build
