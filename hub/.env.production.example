# Only for a hub served by a static host WITHOUT hub-api. Behind hub-api the same values come from HUB_WEB_* at runtime (/config.js)
# and the prebuilt dist needs no rebuild.
VITE_API_MODE=http
VITE_API_BASE=/api
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=https://idp.bank.example/tenant-id/v2.0
VITE_OIDC_CLIENT_ID=HUB_WEB_CLIENT_ID
VITE_OIDC_REDIRECT_URI=https://hub.bank.example/auth/callback
VITE_OIDC_POST_LOGOUT_URI=https://hub.bank.example/
VITE_OIDC_SCOPE=openid profile email
VITE_ROUTER=browser
VITE_KB_URL=https://kb.bank.example
VITE_TELEMETRY=none
VITE_BUILD_SHA=GIT_SHA
