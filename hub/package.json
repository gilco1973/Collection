{
  "name": "crossriver-ai-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:demo": "VITE_ALLOW_MOCK=1 tsc -b && VITE_ALLOW_MOCK=1 vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:shoot": "node tools/shoot.cjs",
    "verify:diff": "python3 tools/diff.py",
    "verify:nav": "node tools/navtest.cjs",
    "verify:e2e": "node tools/navtest.cjs && node tools/intaketest.cjs && node tools/hubtest.cjs && node tools/assistanttest.cjs && node tools/settingstest.cjs",
    "verify": "pnpm typecheck && pnpm lint && vitest run && pnpm build",
    "build:artifact": "VITE_ALLOW_MOCK=1 VITE_ROUTER=hash vite build --base ./ --outDir dist-artifact",
    "screens": "python3 tools/html2jsx.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.50.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "@eslint/js": "^9.39.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
